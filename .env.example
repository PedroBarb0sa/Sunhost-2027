# PostgreSQL (opcional). Sem banco acessível, o projeto usa o modo demonstração.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sunhost_floripa
# auto = tenta PostgreSQL e cai para o arquivo local | true = só arquivo local | false = exige PostgreSQL
DEMO_MODE=auto
# Administrador criado/atualizado a cada inicialização
ADMIN_EMAIL=admin@sunhost.local
ADMIN_PASSWORD=Floripa@2026
# Porta da API. No desenvolvimento o Vite fica na 3000 e encaminha /api para esta porta.
PORT=3001
# Cria anfitriã, hóspede e as 6 acomodações de demonstração (false para desativar)
SEED_DEMO=true
